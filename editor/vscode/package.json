{
  "publisher": "kanbanr",
  "name": "kanbanr",
  "displayName": "kanbanr",
  "version": "0.1.7",
  "icon": "media/icon.png",
  "description": "VS Code viewer and thin command layer for kanbanr — the local, git-backed project management system of record. Open the live board monitor and drive the kanbanr CLI without leaving your editor.",
  "repository": {
    "type": "git",
    "url": "https://github.com/startr-trade/kanbanr.git",
    "directory": "editor/vscode"
  },
  "homepage": "https://kanbanr.startr.trade",
  "bugs": {
    "url": "https://github.com/startr-trade/kanbanr/issues"
  },
  "license": "MIT OR Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "kanban",
    "kanbanr",
    "project-management",
    "board",
    "roadmap"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:kanbanr.openBoard",
    "onCommand:kanbanr.serve",
    "onCommand:kanbanr.board",
    "onCommand:kanbanr.addFeature",
    "onCommand:kanbanr.move"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kanbanr.openBoard",
        "title": "Open Board (Live Monitor)",
        "category": "kanbanr"
      },
      {
        "command": "kanbanr.serve",
        "title": "Start Server (kanbanr serve)",
        "category": "kanbanr"
      },
      {
        "command": "kanbanr.board",
        "title": "Show Board (Text Snapshot)",
        "category": "kanbanr"
      },
      {
        "command": "kanbanr.addFeature",
        "title": "Add Feature",
        "category": "kanbanr"
      },
      {
        "command": "kanbanr.move",
        "title": "Move Feature",
        "category": "kanbanr"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "kanbanr.openBoard"
        },
        {
          "command": "kanbanr.serve"
        },
        {
          "command": "kanbanr.board"
        },
        {
          "command": "kanbanr.addFeature"
        },
        {
          "command": "kanbanr.move"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "4.0.0",
    "ovsx": "1.2.0",
    "typescript": "^5.3.0"
  }
}
