# Settings for the compose site. Copy to .env (git ignores it) and fill in.
# The mode: (a) remote URLs from boards.conf, or (b) local board folders.
COMPOSE_FILE=compose.yaml:compose.remote.yaml
# COMPOSE_FILE=compose.yaml:compose.local.yaml
# The kanbanr image, v0.8.0 or later (the site runs kanbanr serve --board).
KANBANR_IMAGE=ghcr.io/startr-trade/kanbanr:v0.8.0
# Mode (b): one board folder, or a folder whose subfolders hold the boards.
KANBANR_BOARDS_PATH=<path to a board folder, or a folder of board folders>
# Mode (b): comma-separated subfolder names of KANBANR_BOARDS_PATH; empty serves that folder as the one board.
KANBANR_LOCAL_BOARDS=
# The host port the site is published on.
KANBANR_PORT=18080
# The host address the site is published on; 127.0.0.1 keeps it on this machine.
KANBANR_PUBLISH_ADDRESS=127.0.0.1
# Extra host names the monitor answers (comma-separated), e.g. a reverse proxy's.
KANBANR_ALLOWED_HOSTS=
# The user and group the containers run as; in mode (b), the board folders' owner's (id -u, id -g).
KANBANR_UID=10001
KANBANR_GID=10001
