{
  "$schema": "https://anthropic.com/claude-code/plugin.schema.json",
  "name": "kanbanr",
  "description": "kanbanr — the system of record for Claude-driven development. Bundles the kanbanr skill (recover, scope, plan and track work on a git-backed board) with its session-start, stop and session-summary hooks. Needs the kanbanr program on PATH: install it from the GitHub release (https://kanbanr.startr.trade/getting-started/installation.html).",
  "version": "0.1.5",
  "author": {
    "name": "startr-trade / kanbanr maintainers"
  },
  "homepage": "https://kanbanr.startr.trade",
  "repository": "https://github.com/startr-trade/kanbanr",
  "license": "MIT OR Apache-2.0",
  "keywords": [
    "kanbanr",
    "project-management",
    "kanban",
    "workflow",
    "system-of-record"
  ],
  "skills": [
    "./skill/"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/skill/kanbanr/hooks/session-start.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/skill/kanbanr/hooks/session-summary.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/skill/kanbanr/hooks/stop-check.sh"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/skill/kanbanr/hooks/session-summary.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/skill/kanbanr/hooks/session-summary.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
