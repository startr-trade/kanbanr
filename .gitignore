# Rust
/api/target
# Node / web
/web/node_modules
/web/dist
# VS Code extension (editor/vscode): build output + deps
/editor/vscode/node_modules
/editor/vscode/out
/editor/vscode/*.vsix
# Logs / OS
*.log
.DS_Store
# Local Claude Code tooling state (agent worktrees, etc.) — never part of the source repo.
# Claude Code: only the machine-local parts. settings.json is generated per machine by
# `kanbanr hooks install` (it holds absolute paths); the hook scripts ship in skill/kanbanr/hooks.
/.claude/settings.json
/.claude/settings.local.json
/.claude/worktrees/
__pycache__/

# The board is its OWN git repository and now lives BESIDE this one (`../<repo>.kanbanr`), so
# there is nothing here to ignore. The rule stays as a guard: if a `data/` folder is ever created
# inside a checkout again, it must not be committed — it would be embedded as a gitlink, and a
# board inside a checkout is one `git add -A` away from being published.
/data

# Defensive: kanbanr has no accounts/secrets, but if a security.yaml ever appears
# (legacy data, an experiment), never let it into the source repo.
security.yaml
/web/tsconfig.tsbuildinfo
docs/book
/tools/screenshots/target
/tools/screenshots/docs



